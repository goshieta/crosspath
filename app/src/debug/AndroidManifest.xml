<?xml version="1.0" encoding="utf-8"?>
<!--
  debugビルド専用の追加定義。
  BLE検証画面（BleDebugActivity）は通常画面にUI導線を置かず、PCから
    adb shell am start -n com.example.crosspath.debug/com.example.crosspath.BleDebugActivity
  で起動する。adb（shell uid）から起動するため exported="true" が必要。
  このActivityはdebugソースセットにしか宣言が無く、release APKには含まれない。
  なお実装側でも BuildConfig.DEBUG でない場合は即 finish() する。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".BleDebugActivity"
            android:exported="true" />
    </application>
</manifest>
