<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingLeft="@dimen/screen_margin_horizontal"
    android:paddingRight="@dimen/screen_margin_horizontal">

    <!-- カウントダウンカード 仕様 §11.5 赤カード＋白文字 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sc04_countdown_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_margin_large"
        style="@style/Widget.Crosspath.Card"
        app:cardBackgroundColor="@color/dark_colorPrimaryContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/element_margin_medium">

            <TextView
                android:id="@+id/sc04_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_colorOnPrimaryContainer"
                style="@style/TextAppearance.Material3.HeadlineLarge" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 通信状態表示 仕様 §11.5 -->
    <TextView
        android:id="@+id/sc04_comm_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin_medium"
        style="@style/TextAppearance.Material3.BodyMedium" />

    <!-- 通知希望者の生存確認報告（RecyclerView） 仕様 §11.5 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin_medium"
        android:text="@string/sc04_title"
        style="@style/TextAppearance.Material3.TitleMedium" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sc04_safety_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/element_margin_small"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/element_margin_small"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- 下部のボタン行 仕様 §11.5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_margin_large"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sc04_button_watch_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/element_margin_small"
            android:text="@string/action_watch_target"
            style="@style/Widget.Material3.Button.TonalButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sc04_button_notification_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/element_margin_small"
            android:text="@string/action_notification_history"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

</LinearLayout>