<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/element_margin_medium"
    android:paddingRight="@dimen/element_margin_medium"
    android:paddingTop="@dimen/element_margin_small"
    android:paddingBottom="@dimen/element_margin_small"
    android:gravity="center_vertical"
    android:minHeight="@dimen/button_min_height"
    tools:context=".ui.Sc04EmergencyFragment">

    <!-- 対象者の行頭アイコン（装飾） -->
    <ImageView
        android:id="@+id/item_target_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/element_margin_small"
        android:contentDescription="@null"
        android:src="@drawable/ic_person_24"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!-- 対象者名（長い場合は折り返し、右の状態表示を隠さない） 仕様 §11.12 -->
    <TextView
        android:id="@+id/item_target_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/element_margin_small"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

    <!-- 受信状態 仕様 §11.8（文字〇／ーは維持し、色は ViewHolder でテーマ属性から設定する） -->
    <TextView
        android:id="@+id/item_target_status"
        style="@style/Widget.Crosspath.StatusBadge"
        android:importantForAccessibility="no" />

</LinearLayout>
