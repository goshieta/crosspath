<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/screen_margin_horizontal"
    android:paddingRight="@dimen/screen_margin_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 「現在地」ラベル 仕様 §11.4 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_margin_large"
            android:text="@string/sc03_label_location"
            style="@style/TextAppearance.Material3.TitleLarge" />

        <!-- 県ドロップダウン 仕様 §11.4 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sc03_prefecture_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/element_margin_medium"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:hint="@string/sc03_hint_prefecture">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/sc03_prefecture_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                style="@style/TextAppearance.Material3.BodyLarge" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 市町村ドロップダウン 仕様 §11.4（県選択まで無効） -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sc03_municipality_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/element_margin_medium"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:hint="@string/sc03_hint_municipality"
            android:enabled="false">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/sc03_municipality_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                style="@style/TextAppearance.Material3.BodyLarge" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- エラー表示 -->
        <TextView
            android:id="@+id/sc03_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/element_margin_medium"
            android:visibility="gone"
            style="@style/TextAppearance.Material3.BodyMedium" />

        <!-- 確定ボタン（市町村未選択は無効） 仕様 §11.4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sc03_button_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/element_margin_medium"
            android:layout_marginBottom="@dimen/section_margin_large"
            android:enabled="false"
            android:text="@string/action_confirm"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>
</ScrollView>