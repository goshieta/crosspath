<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_margin_horizontal"
    android:background="?attr/colorSurface"
    android:paddingRight="@dimen/screen_margin_horizontal">

    <!-- MaterialToolbar 仕様 §11.12 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/sc02_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/sc02_title" />

    <!-- 生存ボタン（最も強い操作） 仕様 §11.3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sc02_button_survival"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_margin_large"
        android:text="@string/sc02_button_survival"
        style="@style/Widget.Crosspath.Button.Survival"
        android:textColor="@color/light_colorOnPrimaryContainer"
        app:icon="@drawable/ic_sos_24"
        app:iconGravity="textStart" />

    <!-- 生存登録の補足（表示のみ。遷移先と挙動は §11.3 のまま） -->
    <TextView
        android:id="@+id/sc02_survival_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin_small"
        android:text="@string/sc02_survival_hint"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- IDカード 仕様 §11.3 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sc02_id_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin_medium"
        style="@style/Widget.Crosspath.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/element_margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_badge_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/element_margin_small"
                    android:text="@string/label_my_id"
                    style="@style/TextAppearance.Material3.BodyLarge" />
            </LinearLayout>

            <TextView
                android:id="@+id/sc02_id_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/element_margin_small"
                android:textIsSelectable="true"
                style="@style/TextAppearance.Material3.BodyLarge" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/element_margin_small"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sc02_button_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_copy"
                    app:icon="@drawable/ic_content_copy_24"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sc02_button_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/element_margin_small"
                    android:text="@string/action_share"
                    app:icon="@drawable/ic_share_24"
                    style="@style/Widget.Material3.Button.OutlinedButton" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 下余白を広げてコンテンツを上部に寄せる -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 下部タブバーは Activity 側（activity_main.xml）に置く。ここには置かない。 -->

</LinearLayout>